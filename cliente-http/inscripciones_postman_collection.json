    {
      "name": "6. Consultar inscripcion (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () { pm.response.to_have.status(200); });",
              "pm.test(\"id coincide\", function () { pm.expect(String(pm.response.json().id)).to.eql(String(pm.collectionVariables.get(\"inscripcion_id\"))); });"
            ]
          }
        }
      ],
