  "item": [
    {
      "name": "1. Inscribir e1 en IS2 (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", function () { pm.response.to_have.status(201); });",
              "pm.test(\"estado ACTIVA\", function () { pm.expect(pm.response.json().estado).to.eql(\"ACTIVA\"); });",
              "pm.collectionVariables.set(\"inscripcion_id\", pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/inscripciones",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "inscripciones"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"estudiante_id\": \"e1\",\n  \"curso_codigo\": \"IS2\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
