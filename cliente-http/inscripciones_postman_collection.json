    {
      "name": "9. Listar cursos: IS2 con 1 cupo disponible (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () { pm.response.to_have.status(200); });",
              "pm.test(\"IS2 tiene 1 cupo disponible\", function () { var c = pm.response.json().find(function (x) { return x.codigo === \"IS2\"; }); pm.expect(c.cupos_disponibles).to.eql(1); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/cursos",
          "host": [
            "{{base_url}}"
          ],
